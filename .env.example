# Copy to .env and fill in. Each *_API_KEYS var is a comma-separated pool of keys
# that the client rotates through (round-robin) with per-key 429 cooldown and
# provider failover. Leave a provider empty to disable it.

# Google Gemini (Generative Language API)
GOOGLE_AI_API_KEYS=
# Groq (OpenAI-compatible)
GROQ_API_KEYS=
# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEYS=
# Cerebras (OpenAI-compatible)
CEREBRAS_API_KEYS=

# Failover order across the providers above.
LLM_PROVIDER_ORDER=google,groq,openrouter,cerebras
# Per-provider model overrides (defaults shown).
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CEREBRAS_MODEL=llama-3.3-70b
# Sampling temperature for chat answers (lower = more factual).
CHAT_MODEL_TEMPERATURE=0.2

# --- Web app auth (Track C / F-50) ---
# Access token protecting the dashboard + API. Leave empty to disable auth
# (dev bypass). When set, sign in at /login or send it as an
# `Authorization: Bearer <token>` / `X-Auth-Token` header for API clients.
APP_AUTH_TOKEN=
# Flask session signing key (set a long random value in production).
APP_SECRET_KEY=
# Force-disable auth even if APP_AUTH_TOKEN is set (local development only).
AUTH_DEV_BYPASS=
